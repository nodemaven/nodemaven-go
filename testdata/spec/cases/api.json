    {
      "id": "upsert-always-sends-protocol",
      "call": {
        "op": "upsert_whitelist_ip",
        "args": {
          "ip": "192.0.2.8",
          "ports_count": 1
        }
      },
      "responses": [
        {
          "status": 201,
          "body": "{\"ip_id\": 12, \"message\": \"ok\"}"
        }
      ],
      "expect_requests": [
        {
          "method": "POST",
          "path": "/api/v2/base/whitelist/ip/upsert",
          "json_has": {
            "ip": "192.0.2.8",
            "ports_count": 1,
            "protocol": "HTTP"
          }
        }
      ],
      "expect": {
        "ok": true
      },
      "note": "The server does not apply the default its own document declares; without protocol the body is refused 400 (2026-09-09, 16:18 ladder)."
    },
