    {
      "id": "a-3xx-is-an-api-error-and-not-followed",
      "origin": {
        "found": "2026-09-29",
        "by": "porting the API client to Rust",
        "published_unfixed": [
          "pypi nodemaven 0.1.4"
        ],
        "fixed": {
          "python": "2026-09-29, unreleased"
        }
      },
      "call": {
        "op": "me",
        "args": {}
      },
      "responses": [
        {
          "status": 302,
          "body": ""
        }
      ],
      "expect": {
        "error": "api",
        "requests_sent": 1
      },
      "note": "This case pins what the client does with a 3xx its transport returns. The half that matters - the built-in transport not following it and so not carrying the key to another host - lives below the transport seam and is pinned by each SDK's own loopback test. Python 0.1.4's default transport followed redirects and forwarded Authorization."
    },
