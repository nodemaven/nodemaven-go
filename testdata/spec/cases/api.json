    {
      "id": "offset-walk-advances-by-rows-returned",
      "call": {
        "op": "iterate",
        "of": {
          "op": "cities",
          "args": {
            "country__code": "us"
          }
        }
      },
      "responses": [
        {
          "status": 200,
          "rows": {
            "key": "results",
            "count": 1000
          }
        },
        {
          "status": 200,
          "rows": {
            "key": "results",
            "count": 965
          }
        },
        {
          "status": 200,
          "rows": {
            "key": "results",
            "count": 0
          }
        }
      ],
      "expect_requests": [
        {
          "method": "GET",
          "path": "/api/v2/base/locations/cities/",
          "query_has": [
            [
              "limit",
              "1000"
            ],
            [
              "offset",
              "0"
            ]
          ]
        },
        {
          "method": "GET",
          "path": "/api/v2/base/locations/cities/",
          "query_has": [
            [
              "offset",
              "1000"
            ]
          ]
        },
        {
          "method": "GET",
          "path": "/api/v2/base/locations/cities/",
          "query_has": [
            [
              "offset",
              "1965"
            ]
          ]
        }
      ],
      "expect": {
        "rows": 1965
      },
      "note": "limit is capped at 1000 server-side and US cities are 1965 (2026-09-08). A walk that stops on a short page, or advances by the limit asked, returns 1000."
    },
