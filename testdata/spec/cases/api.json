    {
      "id": "the-nested-error-object-is-auth",
      "call": {
        "op": "me",
        "args": {}
      },
      "responses": [
        {
          "status": 401,
          "body": "{\"error\": {\"code\": \"authentication_required\", \"message\": \"Authentication credentials were not provided.\", \"retryable\": false}}"
